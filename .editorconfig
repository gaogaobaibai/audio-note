# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yaml,yml,json,toml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# PowerShell 5.1 reads UTF-8 scripts correctly only with a BOM; keep it on .ps1 files
[*.ps1]
charset = utf-8-bom
